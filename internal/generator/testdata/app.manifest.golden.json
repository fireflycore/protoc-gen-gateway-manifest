{
  "schema": "firefly.gateway.manifest.v1",
  "services": [
    {
      "name": "acme.app.type.v1.AppTypeService",
      "methods": [
        "/acme.app.type.v1.AppTypeService/CreateType",
        "/acme.app.type.v1.AppTypeService/GetTypeInfo",
        "/acme.app.type.v1.AppTypeService/InternalOnly"
      ]
    }
  ],
  "routes": [
    {
      "http_method": "POST",
      "path": "/v1/app/type",
      "full_method": "/acme.app.type.v1.AppTypeService/CreateType"
    },
    {
      "http_method": "GET",
      "path": "/v1/app/type/create-preview",
      "full_method": "/acme.app.type.v1.AppTypeService/CreateType"
    },
    {
      "http_method": "GET",
      "path": "/v1/app/type",
      "full_method": "/acme.app.type.v1.AppTypeService/GetTypeInfo"
    }
  ]
}
